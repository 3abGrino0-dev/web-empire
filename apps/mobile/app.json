{
  "expo": {
    "name": "إمبراطورية الويب",
    "slug": "web-empire",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "webempire",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": { "supportsTablet": true, "bundleIdentifier": "site.webempire.app" },
    "android": {
      "package": "site.webempire.app",
      "adaptiveIcon": {
        "backgroundColor": "#061329",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": { "output": "static", "favicon": "./assets/images/favicon.png" },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/9b2c5e0b-6a58-4d4b-a92d-9f9bdb4aad13"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      ["expo-splash-screen", { "backgroundColor": "#061329", "image": "./assets/images/splash-icon.png", "imageWidth": 120 }],
      ["expo-secure-store", { "configureAndroidBackup": true, "faceIDPermission": "Allow Web Empire to securely access your session." }],
      "expo-localization"
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
